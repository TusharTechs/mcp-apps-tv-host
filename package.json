{
  "name": "mcp-apps-tv-host",
  "version": "0.1.0",
  "description": "Render MCP Apps (ui:// resources) on a TV: an MCP Apps host for WebView-based TV platforms with a D-pad focus shim. Vega (Fire TV) React Native component included.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vega": "./vega/AppHost.tsx"
  },
  "files": [
    "src",
    "vega",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "tv",
    "fire-tv",
    "vega",
    "d-pad",
    "webview"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TusharTechs/mcp-apps-tv-host"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "@types/node": "^22.20.5"
  }
}
